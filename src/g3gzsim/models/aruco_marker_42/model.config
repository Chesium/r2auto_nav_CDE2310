<?xml version="1.0" ?>
<model>
  <name>aruco_marker_42</name>
  <version>1.1</version>
  <sdf version="1.7">model.sdf</sdf>
  <description>
    ArUco marker ID 42 from DICT_4X4_100, printed on a 0.18 m x 0.18 m
    placard with a white quiet zone. Compatible with DICT_4X4_50 since
    ID 42 is shared across the two dictionaries. Used for visual-servo
    docking tests with Nav2's opennav_docking framework.
  </description>
</model>

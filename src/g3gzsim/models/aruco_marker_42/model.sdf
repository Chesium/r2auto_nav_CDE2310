<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="aruco_marker_42">
    <static>true</static>
    <link name="link">
      <!--
        Thin placard. The box is 0.005 m deep along X so the large
        printed face points along the model's +X axis when the marker
        model is placed in the world with identity rotation.

        Physical dimensions of the printed face: 0.18 m x 0.18 m
        (including quiet zone). The inner ArUco pattern occupies
        roughly 0.165 m, matching the existing detector's marker_size
        default — the border adds ~8% padding on each side for reliable
        detection.
      -->
      <visual name="marker_visual">
        <geometry>
          <box><size>0.005 0.18 0.18</size></box>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>materials/textures/aruco_42.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
      <collision name="marker_collision">
        <geometry>
          <box><size>0.005 0.18 0.18</size></box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>

# Copy this file to docker/ros_network.env and edit the values below.
# This file is sourced automatically for every shell in the container.

export RMW_IMPLEMENTATION=rmw_fastrtps_cpp
export ROS_SUPER_CLIENT=TRUE
export ROS_DISCOVERY_SERVER=10.42.0.1:11811
export ROS_DOMAIN_ID=32

# The alias below uses these values so you can change the IP and port quickly.
export ROS_DISCOVERY_INTERFACE=10.42.0.1
export ROS_DISCOVERY_PORT=11811

alias discovery='fastdds discovery -i 0 -l ${ROS_DISCOVERY_INTERFACE} -p ${ROS_DISCOVERY_PORT}'

# Copy this file to docker/ros_network.env and edit the values below.
# This file is sourced automatically for every shell in the container.

# Default: local-only ROS 2 discovery inside the container/host network.
# Leave ROS_DISCOVERY_SERVER unset unless you are intentionally using a Fast DDS discovery server.

export ROS_DOMAIN_ID=32

# Optional Fast DDS discovery server settings for robot/laptop workflows.
# Uncomment and set these to your laptop's reachable IP before running `discovery`.
# export RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# export ROS_SUPER_CLIENT=TRUE
# export ROS_DISCOVERY_SERVER=10.42.0.1:11811
# export ROS_DISCOVERY_INTERFACE=10.42.0.1
export ROS_DISCOVERY_PORT=11811
export ROS_DISCOVERY_INTERFACE=127.0.0.1
